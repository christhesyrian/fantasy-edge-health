# =============================================================================
# Fantasy Health Edge - BACKEND environment template
# Copy to .env and adjust.  .env is git-ignored and must never be committed.
#
# Backend only: the API, the worker, ingestion, and the CLI. The Next.js app
# reads apps/web/.env.example instead and needs none of these.
# =============================================================================

# ---- runtime ----------------------------------------------------------------
FHE_ENV=development                 # development | test | production
FHE_LOG_LEVEL=INFO
FHE_LOG_FORMAT=console              # console | json  (use json in production)

# ---- database ---------------------------------------------------------------
# PostgreSQL is the production target. If unset, the app falls back to a local
# SQLite file so the demo runs with zero infrastructure (see docs/adr/0003).
# FHE_DATABASE_URL=postgresql+asyncpg://fhe:fhe@localhost:5432/fhe
FHE_DATABASE_URL=

# ---- cache / event bus ------------------------------------------------------
# Optional. If unset, an in-process event bus + cache is used (single-worker only).
# FHE_REDIS_URL=redis://localhost:6379/0
FHE_REDIS_URL=

# ---- object storage (optional, for immutable raw ingestion artifacts) -------
# FHE_S3_ENDPOINT_URL=http://localhost:9000
# FHE_S3_ACCESS_KEY_ID=
# FHE_S3_SECRET_ACCESS_KEY=
# FHE_S3_BUCKET=fhe-raw

# ---- api --------------------------------------------------------------------
FHE_API_HOST=127.0.0.1
FHE_API_PORT=8000
# Comma-separated exact origins. Never use "*" with credentials enabled.
FHE_CORS_ORIGINS=http://localhost:3000

# ---- providers --------------------------------------------------------------
# Sleeper is public and needs NO credentials. Documented limit: <1000 req/min.
FHE_SLEEPER_BASE_URL=https://api.sleeper.app/v1
FHE_SLEEPER_TIMEOUT_SECONDS=10
FHE_SLEEPER_MAX_RPM=600             # self-imposed ceiling, well under provider limit

# Live draft polling cadence (seconds). Stays far inside Sleeper's rate limit.
FHE_DRAFT_POLL_INTERVAL_SECONDS=3.0
FHE_DRAFT_POLL_MAX_INTERVAL_SECONDS=30.0

# nflverse is public data on GitHub Releases; no credentials required.
FHE_NFLVERSE_BASE_URL=https://github.com/nflverse/nflverse-data/releases/download

# ---- frontend ---------------------------------------------------------------
# The Next.js app has its own template: apps/web/.env.example. Nothing in this
# file is read by the frontend, and nothing there is read by the backend. They
# are separated so a frontend-only deployment is never asked for a database URL.

# ---- FantasyPros (optional, licensed) ---------------------------------------
# Personal API key from https://secure.fantasypros.com/api-keys/request/
# Keep it confidential: never commit it, never put it behind NEXT_PUBLIC_.
# The licence allows 1 call/second and 100 calls/day; both are enforced in code,
# and the daily counter is persisted so a restart cannot reset it.
# Without a key this provider stays disabled and CSV import is used instead.
# FHE_FANTASYPROS_API_KEY=

# ---- optional LLM assistant (the product is fully usable without this) ------
# FHE_ANTHROPIC_API_KEY=
