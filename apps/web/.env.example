# =============================================================================
# Fantasy Health Edge - FRONTEND environment (apps/web)
# =============================================================================
# Copy to apps/web/.env.local and adjust. .env.local is git-ignored.
#
# This file contains ONLY what the Next.js app reads. Backend settings
# (database, Redis, providers, polling, keys) live in the repository root
# .env.example and are never needed to build or run the frontend.
#
# Everything here is NEXT_PUBLIC_*, which means it is inlined into the
# JavaScript bundle and readable by anyone using the site. Never put a secret,
# token, or key behind this prefix.
# =============================================================================

# ---- which backend the app talks to -----------------------------------------
# OPTIONAL. Defaults to http://localhost:8000 when unset, which is the normal
# local setup (`make dev-api`).
#
#   local development   http://localhost:8000
#   deployed frontend   https://your-api-host.example.com   (no trailing slash)
#
# Ignored entirely when NEXT_PUBLIC_PREVIEW_MODE=fixtures, because that mode
# makes no network calls at all.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- preview mode -----------------------------------------------------------
# OPTIONAL. Unset or "live" (the default) means every screen is served by the
# real FastAPI backend.
#
# Set to "fixtures" to render the war room from recorded engine output with no
# backend at all. This exists so a design tool or cloud preview can work on the
# UI without hosting Python. It is loudly labelled SYNTHETIC in the interface,
# refuses to connect a Sleeper league, and never reports a live connection.
#
# Never set this in production.
# NEXT_PUBLIC_PREVIEW_MODE=fixtures
